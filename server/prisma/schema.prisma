generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mongodb"
  url          = env("DATABASE_URL")
  // MongoDB has no native foreign-key constraints, so Prisma emulates
  // referential actions (onDelete: Cascade, etc.) in the client instead.
  relationMode = "prisma"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
  COMPLETED
}

enum CancelledBy {
  PATIENT
  DOCTOR
}

enum LabBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum NotificationCategory {
  APPOINTMENT
  LAB
  REMINDER
  SYSTEM
}

enum FlowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  // Null for accounts created through Google sign-in.
  passwordHash String?
  // Google's stable account id ("sub"). Unique only where set — a plain
  // @unique would collide on every user without one, so prisma/ensure-indexes.js
  // creates it as a partial unique index instead.
  googleId     String?
  avatarUrl    String?
  role         Role
  name         String
  phone        String?
  dob          DateTime?
  gender       String?
  bloodGroup   String?
  emergencyContact String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctorProfile DoctorProfile?
  savedAddresses SavedAddress[]
  appointments  Appointment[]   @relation("PatientAppointments")
  labBookings   LabBooking[]
  notifications Notification[]
}

model SavedAddress {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  street    String
  city      String
  state     String?
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model DoctorProfile {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @unique @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty      String
  experience     String?
  qualifications String?
  clinic         String?
  fee            Int      @default(0)
  bio            String?
  image          String?
  rating         Float    @default(0)
  locationUrl    String?
  bufferMins     Int      @default(0)
  licenseNumber  String?
  clinicAddress  String?
  gender         String?

  availability Availability[]
  timeOff      TimeOff[]
  appointments Appointment[]   @relation("DoctorAppointments")

  @@index([specialty])
}

model Availability {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  doctorId         String        @db.ObjectId
  doctor           DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek        Int // 0 = Sunday .. 6 = Saturday
  startTime        String // "09:00"
  endTime          String // "17:00"
  slotDurationMins Int           @default(30)

  @@index([doctorId])
}

model TimeOff {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  doctorId  String        @db.ObjectId
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      DateTime
  startTime String?
  endTime   String?
  reason    String?

  @@index([doctorId, date])
}

model Appointment {
  id                  String            @id @default(auto()) @map("_id") @db.ObjectId
  patientId           String            @db.ObjectId
  patient             User              @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId            String            @db.ObjectId
  doctor              DoctorProfile     @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  scheduledAt         DateTime
  type                String            @default("in-person")
  feeAtBooking        Int?
  status              AppointmentStatus @default(PENDING)
  notes               String?
  cancelledBy         CancelledBy?
  cancellationReason  String?
  remindedAt24h       DateTime?
  remindedAt1h        DateTime?
  prescriptionNotes   String?
  diagnosisNotes      String?
  reportUrls          String[]          @default([])
  paymentStatus       String            @default("PAY_AT_CLINIC")
  paymentMethod       String?
  rescheduledCount    Int               @default(0)
  originalScheduledAt DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Double-booking is prevented by a *partial* unique index (only PENDING /
  // CONFIRMED appointments hold a slot, so cancelled slots can be rebooked).
  // Prisma's schema can't express partial indexes; prisma/seed.js creates it.
  @@index([doctorId, scheduledAt])
  @@index([patientId])
}

model LabTest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  price       Int
  createdAt   DateTime @default(now())

  items LabBookingItem[]
}

model LabBooking {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  patientId     String           @db.ObjectId
  patient       User             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime
  status        LabBookingStatus @default(PENDING)
  notes         String?
  addressId     String?          @db.ObjectId
  address       String?
  paymentStatus String           @default("PAY_ON_COLLECTION")
  totalAmount   Int?
  reportUrls    String[]         @default([])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  items LabBookingItem[]

  @@index([patientId])
}

model LabBookingItem {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  labBookingId   String     @db.ObjectId
  labBooking     LabBooking @relation(fields: [labBookingId], references: [id], onDelete: Cascade)
  labTestId      String     @db.ObjectId
  labTest        LabTest    @relation(fields: [labTestId], references: [id])
  priceAtBooking Int

  @@index([labBookingId])
  @@index([labTestId])
}

model Notification {
  id                String               @id @default(auto()) @map("_id") @db.ObjectId
  userId            String               @db.ObjectId
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          NotificationCategory
  type              String
  title             String
  body              String
  readAt            DateTime?
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime             @default(now())

  @@index([userId, readAt])
}

// Keeps viaSocket's own flow id as the primary key (not an ObjectId) so the
// embed's flow.id maps directly to _id with no translation layer.
// ownerUserId null = clinic-wide flow (e.g. migrated from the old flows.json),
// which receives every event; otherwise only that user's own events.
model ViaSocketFlow {
  id           String     @id @map("_id")
  ownerUserId  String?    @db.ObjectId
  title        String?
  description  String?
  webhookUrl   String?
  payload      Json?
  eventName    String?
  appKey       String?
  serviceIcons String[]   @default([])
  status       FlowStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([eventName, status])
  @@index([ownerUserId])
}
