NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string (from Atlas -> Connect -> Drivers).
# Include the database name before the query string, e.g. .../bookease?retryWrites=true...
DATABASE_URL=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/bookease?retryWrites=true&w=majority

# Used to sign the session JWT cookie. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# viaSocket embed credentials (server-side only, never sent to the client)
VIASOCKET_ORG_ID=4160
VIASOCKET_PROJECT_ID=projvB6ZLDza
VIASOCKET_EMBED_SECRET=

# Set in production to the deployed origin if client/server ever run as
# separate services; leave unset when Express serves the built SPA itself.
CLIENT_ORIGIN=
